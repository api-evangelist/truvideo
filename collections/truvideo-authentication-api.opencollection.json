{
  "opencollection": "1.0.0",
  "info": {
    "name": "TruVideo Platform Authentication API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Login",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.truvideo.com/api/v2/authentication/login",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Logs the user into the system and returns a JWT access token for the passed credentials."
        },
        {
          "info": {
            "name": "Logout",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.truvideo.com/api/v2/authentication/logout"
          },
          "docs": "Logs the user out of the system. Empty request and response body. Authorization header must be present."
        }
      ]
    }
  ],
  "bundled": true
}